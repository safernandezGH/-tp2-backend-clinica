  "item": [
    {
      "name": "Entrega 1 - Auth",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/health"
          }
        },
        {
          "name": "Listar coberturas",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/auth/coberturas"
          }
        },
        {
          "name": "Registro de paciente",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/auth/registro",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Nicolas\",\n  \"apellido\": \"Gomez\",\n  \"dni\": \"30251255\",\n  \"email\": \"nicolas.test@test.com\",\n  \"password\": \"123456\",\n  \"fecha_nacimiento\": \"2000-03-14\",\n  \"id_cobertura\": 1,\n  \"telefono\": \"3424555555\"\n}"
            }
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const data = pm.response.json();",
                  "if (data && data.datos && data.datos.token) {",
                  "  pm.collectionVariables.set('token', data.datos.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"dni\": \"30251255\",\n  \"password\": \"123456\"\n}"
            }
          }
        },
        {
          "name": "Perfil (protegido)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{base_url}}/auth/perfil"
          }
        },
        {
          "name": "Perfil sin token (debe dar 401)",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/auth/perfil"
          }
        },
        {
          "name": "Admin test (debe dar 403 si no sos admin)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{base_url}}/auth/admin-test"
          }
