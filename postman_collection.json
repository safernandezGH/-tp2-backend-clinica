{
  "info": {
    "name": "Backend Clinica - Semana 3",
    "description": "Turnos, historial clínico y notificaciones",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:3000" },
    { "key": "token_paciente", "value": "" },
    { "key": "token_medico", "value": "" },
    { "key": "token_operador", "value": "" }
  ],
  "item": [
    {
      "name": "0. Login paciente (guarda token_paciente)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const data = pm.response.json();",
              "if (data && data.datos && data.datos.token) {",
              "  pm.collectionVariables.set('token_paciente', data.datos.token);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{base_url}}/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"dni\": \"30251255\",\n  \"password\": \"123456\"\n}"
        }
      }
    },
    {
      "name": "1. Login medico (guarda token_medico)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const data = pm.response.json();",
              "if (data && data.datos && data.datos.token) {",
              "  pm.collectionVariables.set('token_medico', data.datos.token);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{base_url}}/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"dni\": \"20111222\",\n  \"password\": \"medico123\"\n}"
        }
      }
    },
    {
      "name": "2. Login operador (guarda token_operador)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const data = pm.response.json();",
              "if (data && data.datos && data.datos.token) {",
              "  pm.collectionVariables.set('token_operador', data.datos.token);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{base_url}}/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"dni\": \"15200548\",\n  \"password\": \"operador123\"\n}"
        }
      }
    },
    {
      "name": "3. Alta de Turno (fuera de rango - debe fallar 400)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token_paciente}}" }
        ],
        "url": "{{base_url}}/turnos",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id_agenda\": 2,\n  \"fecha\": \"2025-10-20\",\n  \"hora\": \"14:00\",\n  \"nota\": \"Consulta fuera del rango de las 15hs\"\n}"
        }
      }
    },
    {
      "name": "4. Alta de Turno (superpuesto - debe fallar 409)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token_paciente}}" }
        ],
        "url": "{{base_url}}/turnos",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id_agenda\": 2,\n  \"fecha\": \"2025-10-27\",\n  \"hora\": \"15:30\",\n  \"nota\": \"Pisa el turno que ya existe de Franco\"\n}"
        }
      }
    },
    {
      "name": "5. Alta de Turno (exitoso - 201)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token_paciente}}" }
        ],
        "url": "{{base_url}}/turnos",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id_agenda\": 2,\n  \"fecha\": \"2025-10-20\",\n  \"hora\": \"16:00\",\n  \"nota\": \"Consulta de rutina\"\n}"
        }
      }
    },
    {
      "name": "6. Cancelar turno (paciente - 200)",
      "request": {
        "method": "PATCH",
        "header": [{ "key": "Authorization", "value": "Bearer {{token_paciente}}" }],
        "url": "{{base_url}}/turnos/3/cancelar"
      }
    },
    {
      "name": "7. Atender turno (medico - 200)",
      "request": {
        "method": "PATCH",
        "header": [{ "key": "Authorization", "value": "Bearer {{token_medico}}" }],
        "url": "{{base_url}}/turnos/2/atender"
      }
    },
    {
      "name": "8. Mis turnos (paciente - 200)",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token_paciente}}" }],
        "url": "{{base_url}}/turnos/mis-turnos"
      }
    },
    {
      "name": "9. Turnos por medico (medico - 200)",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token_medico}}" }],
        "url": "{{base_url}}/turnos/por-medico?fecha=2025-10-20"
      }
    },
    {
      "name": "10. Turnos por sede (operador - 200)",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token_operador}}" }],
        "url": "{{base_url}}/turnos/por-sede?fecha=2025-10-20"
      }
    },
    {
      "name": "11. Registrar historial clinico (medico - 201)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token_medico}}" }
        ],
        "url": "{{base_url}}/historial",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id_turno\": 2,\n  \"diagnostico\": \"Gripe estacional\",\n  \"tratamiento\": \"Descanso e hidratación\",\n  \"observaciones\": \"Control en 7 días\"\n}"
        }
      }
    },
    {
      "name": "12. Consultar historial clinico (paciente - 200)",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token_paciente}}" }],
        "url": "{{base_url}}/historial"
      }
    },
    {
      "name": "13. Listar notificaciones (paciente - 200)",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token_paciente}}" }],
        "url": "{{base_url}}/notificaciones"
      }
    },
    {
      "name": "14. Marcar notificacion como leida (paciente - 200)",
      "request": {
        "method": "PATCH",
        "header": [{ "key": "Authorization", "value": "Bearer {{token_paciente}}" }],
        "url": "{{base_url}}/notificaciones/3/leer"
      }
    }
  ]
}